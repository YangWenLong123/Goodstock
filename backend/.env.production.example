APP_NAME=Goodstock 商品管理 API
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=along
# 实际密码保存在被 Git 忽略的 .env.production 中，单独上传到服务器。
DB_PASSWORD=replace-with-your-database-password
DB_NAME=fastapi_shop
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://124.223.60.74"]
SEED_ADMIN_USERNAME=admin
# setup_env.py --production 会生成随机初始密码，首次建库前可自行修改。
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
